# This is Git's per-user configuration file.
[user]
	name = Doug Gainey
	email = douggainey@gmail.com

[gui]
	gcwarning = false

[diff]
	tool = winmerge
[difftool]
	prompt = false
[difftool "winmerge"]
	cmd = "C:/Program Files/WinMerge/WinMergeU.exe" -e "$LOCAL" "$REMOTE"

[merge]
	tool = winmerge
[mergetool]
	prompt = false
[mergetool "winmerge"]
	cmd = "C:/Program Files/WinMerge/WinMergeU.exe" -e -u -dl "Local" -dr "Remote" "$LOCAL" "$REMOTE" "$MERGED"
	trustExitCode = true

[alias]
	co = checkout
	st = status
	su = submodule update --init --recursive
	pu = !git pull --rebase && git submodule update --init --recursive
	cm = commit -m
	cma = commit -a -m
	db = branch -D
	drb = push origin --delete
